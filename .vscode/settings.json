{
  // Whitespace, EOL and indentation live in .editorconfig at the repo root; this file
  // is only for switching the formatter off where a rewrite is a behaviour change.
  //
  // HTML is the one that matters here: _layouts/default.html is Liquid, not markup.
  // A formatter that wraps a long {{ site.time | date: ... }} tag across lines inserts a
  // newline into the rendered value, and nothing in this repo tests the chrome, so it
  // would reach the site unseen. That is how the footer time nearly shipped broken.
  "[html]": {
    "editor.formatOnSave": false
  },
  // The README surface and everything under apps/ is generated by pages.yml, so a
  // reflowed table is churn the next render erases anyway.
  "[markdown]": {
    "editor.formatOnSave": false
  },
  "[yaml]": {
    "editor.formatOnSave": false
  }
  // CSS and the reader script keep their formatter: a reformat there is cosmetic and
  // shows up as a reviewable diff, unlike a template or a markdown table.
}
